# ============================================================
# Alghdeer — Environment Variables (copy to .env.local and fill)
# ============================================================

# --- Staff login (REQUIRED in production) ---
# Comma-separated list of staff emails allowed into the dashboard
STAFF_EMAILS="mahmoudkonsowa678@gmail.com,mahmoudkonsowa3030@gmail.com"

# Option A: plain password (min 10 chars, letters + digits)
STAFF_PASSWORD="change-me-strong-password"

# Option B (recommended instead of A): scrypt hash — the plain password
# never appears anywhere. Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16);console.log(s.toString('hex')+':'+c.scryptSync('YOUR_PASSWORD',s,64).toString('hex'))"
# STAFF_PASSWORD_SCRYPT="saltHex:hashHex"

# Random 32+ char secret used to sign staff session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=""

# --- Email notifications ---
# Where booking notifications are sent (comma-separated for several inboxes)
NOTIFY_EMAIL=""

# Provider 1 — Resend (recommended): https://resend.com → API key + verified sender
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Alghdeer <bookings@yourdomain.com>"

# Provider 2 — SMTP via nodemailer (requires `npm i nodemailer`)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="gmail-app-password"
# EMAIL_FROM="you@gmail.com"

# Provider 3 — Web3Forms: https://web3forms.com (free access key)
# WEB3FORMS_ACCESS_KEY=""

# Fallback — if only NOTIFY_EMAIL is set, FormSubmit is used:
# the first booking triggers a one-time activation email; click "Activate" once.

# --- Storage ---
# Cloud JSON bin holding bookings (server-side only, never shipped to browsers)
# BOOKINGS_DB_URL="https://extendsclass.com/api/json-storage/bin/xxxxxxx"

# --- Site ---
# Public site URL (used for the dashboard link inside notification emails)
# SITE_URL="https://alghdeer.com"
